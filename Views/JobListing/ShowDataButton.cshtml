@{
    ViewData["Title"] = "Show API Data";
}

<h1>Click the button to load data</h1>

<button id="loadDataButton" class="btn btn-primary">Load Data</button>

<div id="dataContainer" style="display: none;">
    <h2>API Data</h2>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Slug</th>
                <th>Title</th>
                <th>Created On</th>
                <th>Company Name</th>
                <th>URL</th>
            </tr>
        </thead>
        <tbody id="dataBody">
        </tbody>
    </table>
</div>
<div id="loadingIndicator" style="display: none; text-align: center; margin-top: 10px;">
    <i class="fas fa-spinner fa-spin fa-3x"></i>  <p>Loading data...</p>
</div>

<script>
        $(document).ready(function () {
            function loadData() {
                // Show the loading indicator and disable the button
                $("#loadingIndicator").show();
                $("#loadDataButton").prop("disabled", true);
                $("body").css("cursor", "wait"); // Change mouse cursor

                $.ajax({
                    url: '@Url.Action("GetData", "JobListing")',
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        // Hide the loading indicator and re-enable the button
                        $("#loadingIndicator").hide();
                        $("#loadDataButton").prop("disabled", false);
                        $("body").css("cursor", "default");

                        if (data && data.length > 0) {
                            $("#dataBody").empty();
                            $.each(data, function (i, item) {
                                var row = '<tr>' +
                                    '<td>' + item.slug + '</td>' +
                                    '<td>' + item.title + '</td>' +
                                    '<td>' + item.created_at_date + '</td>' +
                                    '<td>' + item.company_name + '</td>' +
                                    '<td><a href="' + item.url + '">' + item.url + '</a></td>' +
                                    '</tr>';
                                $("#dataBody").append(row);
                            });
                            $("#dataContainer").show();
                            // Store the data in sessionStorage
                            sessionStorage.setItem('apiData', JSON.stringify(data));
                        } else {
                            alert("No data received from the API.");
                        }
                    },
                    error: function (xhr, status, error) {
                        // Hide the loading indicator and re-enable the button
                        $("#loadingIndicator").hide();
                        $("#loadDataButton").prop("disabled", false);
                        $("body").css("cursor", "default");
                        console.error("Error fetching data:", error);
                        alert("Failed to load data from the API.");
                    }
                });
            }

            // Check if data is already in sessionStorage
            var storedData = sessionStorage.getItem('apiData');
            if (storedData) {
                try {
                    var data = JSON.parse(storedData);
                     if (data && data.length > 0) {
                            $("#dataBody").empty();
                            $.each(data, function (i, item) {
                                var row = '<tr>' +
                                    '<td>' + item.slug + '</td>' +
                                    '<td>' + item.title + '</td>' +
                                    '<td>' + item.created_at_date + '</td>' +
                                    '<td>' + item.company_name + '</td>' +
                                    '<td><a href="' + item.url + '">' + item.url + '</a></td>' +
                                    '</tr>';
                                $("#dataBody").append(row);
                            });
                            $("#dataContainer").show();
                     }
                     else{
                         loadData();
                     }

                } catch (e) {
                    // Handle parsing error (e.g., clear the storage and re-fetch)
                    sessionStorage.removeItem('apiData');
                    loadData(); //or show error message
                }
            } else {
                // If not, fetch it
                loadData();
            }

            $("#loadDataButton").click(function () {
                loadData();
            });
        });
    </script>